{
    "name": "backend",
    "version": "1.0.0",
    "description": "Backend API for the online writing platform",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json --noEmit",
        "start": "node dist/server.js",
        "test": "tsx --test tests/health.test.ts",
        "lint": "eslint src",
        "check": "npm run typecheck && npm run lint && npm run test && npm run build",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:validate": "prisma validate"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "pg": "^8.22.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.8.0",
        "globals": "^17.8.0",
        "jsdom": "26.1.0",
        "nodemon": "^3.1.14",
        "prisma": "^7.9.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0"
    }
}
