{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the online writing platform",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "worker": "tsx src/worker.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "check": "npm run prisma:validate && npm run typecheck && npm run lint && npm run test && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma generate && prisma db seed",
    "prisma:studio": "prisma studio",
    "admin:set-role": "tsx scripts/set-user-role.ts",
    "test": "node scripts/run-tests.mjs",
    "test:integration:prepare": "node scripts/assert-test-database-safe.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.7",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.5",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "6.0.1",
    "redis": "6.2.1",
    "sanitize-html": "^2.17.7",
    "sharp": "0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true
  }
}
