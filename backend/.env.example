NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://writing_user:writing_password@localhost:5432/writing_platform

CLIENT_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173

ACCESS_TOKEN_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL_SECONDS=900

SESSION_TTL_DAYS=30

REFRESH_COOKIE_NAME=writing_refresh_token

EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

MAIL_TRANSPORT=console # change to smtp for production
MAIL_FROM=Writing Platform <no-reply@example.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

TRUST_PROXY=false
LOG_LEVEL=info

TERMS_VERSION=v1