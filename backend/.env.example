NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://writing_user:writing_password@localhost:5432/writing_platform
# Optional in development/test; mandatory in production. Security limits never fall back in production.
REDIS_URL=redis://localhost:6379
CLIENT_ORIGINS=http://localhost:5173
WEB_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# Generate a long random secret for every deployment.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Use a separate random value; required in production.
EMAIL_VERIFICATION_SECRET=replace-with-at-least-32-random-characters
PHONE_OTP_SECRET=replace-with-at-least-32-random-characters
# Use a different random value in production.
CURSOR_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=30
REFRESH_COOKIE_NAME=writing_refresh_token

PHONE_OTP_TTL_MINUTES=5
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
AUTH_SIGNUP_GRANT_TTL_MINUTES=15

# console prints OTPs to the backend log in development. Production requires kavenegar.
SMS_TRANSPORT=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=

# Google Identity Services web client ID.
GOOGLE_CLIENT_ID=

# Sign in with Apple web configuration. Configure all or leave all empty.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store multiline .p8 content with literal \n separators when using a single-line env file.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
EMAIL_CHANGE_TTL_MINUTES=30
EMAIL_CHANGE_RESEND_COOLDOWN_SECONDS=60

# Development can use console. Production validation requires smtp.
MAIL_TRANSPORT=console
MAIL_FROM=Writing Platform <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# local keeps assets under MEDIA_LOCAL_ROOT. Use s3 for object storage.
MEDIA_PROVIDER=local
MEDIA_LOCAL_ROOT=./var/media
MEDIA_MAX_BYTES=5000000
MEDIA_MAX_PIXELS=40000000
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

TRUST_PROXY=false
LOG_LEVEL=info
TERMS_VERSION=v1
JOB_WORKER_ENABLED=true

# Integration tests: never point this at DATABASE_URL. Destructive setup also
# requires ALLOW_DESTRUCTIVE_TEST_DATABASE=true and verifies connected identities.
TEST_DATABASE_URL=
ALLOW_DESTRUCTIVE_TEST_DATABASE=false

# Seed refuses production unless this is deliberately set to true.
ALLOW_PRODUCTION_SEED=false

# Paid features are intentionally disabled until a real entitlement provider exists.
