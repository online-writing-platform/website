generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum StoryStatus {
  DRAFT
  ONGOING
  COMPLETED
  HIATUS
}

enum StoryVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum ChapterStatus {
  DRAFT
  PUBLISHED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  username        String    @unique @db.VarChar(30)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String    @map("display_name") @db.VarChar(80)
  bio             String?   @db.VarChar(500)
  avatarUrl       String?   @map("avatar_url") @db.Text
  termsAcceptedAt DateTime  @default(now()) @map("terms_accepted_at")
  termsVersion    String    @default("v1") @map("terms_version") @db.VarChar(20)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  stories Story[]
  sessions Session[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  isPersistent     Boolean   @default(false) @map("is_persistent")
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Story {
  id          String          @id @default(uuid()) @db.Uuid
  authorId    String          @map("author_id") @db.Uuid
  title       String          @db.VarChar(200)
  slug        String          @unique @db.VarChar(220)
  description String          @db.Text
  coverUrl    String?         @map("cover_url") @db.Text
  language    String          @default("fa") @db.VarChar(10)
  status      StoryStatus     @default(DRAFT)
  visibility  StoryVisibility @default(PRIVATE)
  isMature    Boolean         @default(false) @map("is_mature")
  publishedAt DateTime?       @map("published_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([authorId])
  @@index([status, visibility])
  @@map("stories")
}

model Chapter {
  id          String        @id @default(uuid()) @db.Uuid
  storyId     String        @map("story_id") @db.Uuid
  title       String        @db.VarChar(200)
  position    Int
  content     String        @db.Text
  status      ChapterStatus @default(DRAFT)
  wordCount   Int           @default(0) @map("word_count")
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, position])
  @@index([storyId, status])
  @@map("chapters")
}