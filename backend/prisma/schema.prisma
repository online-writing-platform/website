generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AuthProvider {
  PASSWORD
  PHONE
  GOOGLE
  APPLE
}

enum StoryStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  HIATUS
  ARCHIVED
}

enum StoryVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum StoryRights {
  ALL_RIGHTS_RESERVED
  PUBLIC_DOMAIN
  CREATIVE_COMMONS
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum RevisionReason {
  CHECKPOINT
  PUBLISH
  UNPUBLISH
  RESTORE_SOURCE
  RESTORED
}

enum ReadingHistoryType {
  STARTED
  CHAPTER_CHANGED
  RESUMED
  COMPLETED
}

enum ReadActorType {
  AUTHENTICATED
  ANONYMOUS
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DEAD
}

enum ModerationState {
  VISIBLE
  HIDDEN
  REMOVED
}

enum CommentStatus {
  ACTIVE
  HIDDEN
  DELETED
}

enum NotificationType {
  FOLLOW
  COMMENT
  COMMENT_REPLY
  CHAPTER_VOTE
  STORY_PUBLISHED
  CHAPTER_PUBLISHED
  MODERATION
  SECURITY
}

enum ReportTargetType {
  USER
  STORY
  CHAPTER
  COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_OR_ABUSE
  SEXUAL_CONTENT
  VIOLENCE
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  SUSPEND_USER
  RESTORE_USER
  HIDE_STORY
  RESTORE_STORY
  HIDE_CHAPTER
  RESTORE_CHAPTER
  HIDE_COMMENT
  RESTORE_COMMENT
}

enum ReaderTheme {
  SYSTEM
  LIGHT
  DARK
  SEPIA
}

enum MediaProvider {
  LOCAL
  S3
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email String @unique @db.VarChar(320)

  username           String @db.VarChar(20)
  usernameNormalized String @unique @map("username_normalized") @db.VarChar(20)

  passwordHash String @map("password_hash") @db.VarChar(255)

  displayName String  @map("display_name") @db.VarChar(80)
  bio         String? @db.VarChar(500)
  avatarUrl   String? @map("avatar_url") @db.Text

  birthDate       DateTime  @map("birth_date") @db.Date
  emailVerifiedAt DateTime? @map("email_verified_at")

  status UserStatus @default(ACTIVE)
  role   UserRole   @default(USER)

  termsAcceptedAt DateTime @default(now()) @map("terms_accepted_at")
  termsVersion    String   @map("terms_version") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stories                Story[]
  sessions               Session[]
  authIdentities         AuthIdentity[]
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  emailChangeToken       EmailChangeToken?
  preferences            UserPreference?

  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  blocksCreated  Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")
  mutesCreated   Mute[]  @relation("Muter")
  mutesReceived  Mute[]  @relation("Muted")

  libraryEntries  LibraryEntry[]
  readingProgress ReadingProgress[]
  readingLists    ReadingList[]
  readingHistory  ReadingHistory[]
  readSignals     ReadSignal[]

  chapterVotes ChapterVote[]
  comments     Comment[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsActed    Notification[] @relation("NotificationActor")

  reportsSubmitted Report[] @relation("ReportReporter")
  reportsAssigned  Report[] @relation("ReportAssignee")

  moderationActions ModerationAction[] @relation("ModerationActor")
  revisionsCreated  ChapterRevision[]  @relation("RevisionCreator")
  auditLogs         AuditLog[]         @relation("AuditActor")
  mediaAssets       MediaAsset[]
  stats             UserStats?

  @@index([status, createdAt])
  @@map("users")
}

model AuthIdentity {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  provider        AuthProvider
  providerSubject String       @map("provider_subject") @db.VarChar(320)

  passwordHash String?   @map("password_hash") @db.VarChar(255)
  verifiedAt   DateTime? @map("verified_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@map("auth_identities")
}

model UserPreference {
  userId String @id @map("user_id") @db.Uuid

  allowMatureContent Boolean     @default(false) @map("allow_mature_content")
  readerTheme        ReaderTheme @default(SYSTEM) @map("reader_theme")
  fontScale          Float       @default(1) @map("font_scale")
  lineHeight         Float       @default(1.75) @map("line_height")

  notifyFollow           Boolean @default(true) @map("notify_follow")
  notifyComment          Boolean @default(true) @map("notify_comment")
  notifyReply            Boolean @default(true) @map("notify_reply")
  notifyVote             Boolean @default(true) @map("notify_vote")
  notifyChapterPublished Boolean @default(true) @map("notify_chapter_published")
  notifyModeration       Boolean @default(true) @map("notify_moderation")
  notifySecurity         Boolean @default(true) @map("notify_security")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  refreshTokenHash String @unique @map("refresh_token_hash") @db.Char(64)

  userAgent String? @map("user_agent") @db.VarChar(512)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  consumedTokens ConsumedRefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model ConsumedRefreshToken {
  tokenHash String @id @map("token_hash") @db.Char(64)
  sessionId String @map("session_id") @db.Uuid

  consumedAt DateTime  @default(now()) @map("consumed_at")
  expiresAt  DateTime  @map("expires_at")
  replayedAt DateTime? @map("replayed_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt])
  @@index([expiresAt])
  @@map("consumed_refresh_tokens")
}

model EmailVerificationToken {
  userId String @id @map("user_id") @db.Uuid

  tokenHash      String @unique @map("token_hash") @db.Char(64)
  failedAttempts Int    @default(0) @map("failed_attempts")

  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PhoneOtpChallenge {
  id          String @id @default(uuid()) @db.Uuid
  phoneNumber String @unique @map("phone_number") @db.VarChar(32)

  codeHash       String @map("code_hash") @db.VarChar(64)
  failedAttempts Int    @default(0) @map("failed_attempts")

  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("phone_otp_challenges")
}

model PhoneSignupGrant {
  id          String @id @default(uuid()) @db.Uuid
  phoneNumber String @unique @map("phone_number") @db.VarChar(32)
  tokenHash   String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("phone_signup_grants")
}

model PasswordResetToken {
  userId String @id @map("user_id") @db.Uuid

  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  userId String @id @map("user_id") @db.Uuid

  newEmail  String @unique @map("new_email") @db.VarChar(320)
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt DateTime @map("expires_at")
  sentAt    DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_change_tokens")
}

model Genre {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(80)
  name String @unique @db.VarChar(80)

  description String? @db.VarChar(500)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stories Story[]

  @@index([isActive, sortOrder])
  @@map("genres")
}

model Tag {
  id String @id @default(uuid()) @db.Uuid

  slug String @unique @db.VarChar(80)
  name String @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at")

  stories StoryTag[]

  @@map("tags")
}

model Story {
  id           String  @id @default(uuid()) @db.Uuid
  authorId     String  @map("author_id") @db.Uuid
  genreId      String? @map("genre_id") @db.Uuid
  coverAssetId String? @map("cover_asset_id") @db.Uuid

  title       String  @db.VarChar(200)
  slug        String  @unique @db.VarChar(220)
  description String  @db.Text
  coverUrl    String? @map("cover_url") @db.Text

  language String @default("fa") @db.VarChar(10)

  status     StoryStatus     @default(DRAFT)
  visibility StoryVisibility @default(PRIVATE)
  rights     StoryRights     @default(ALL_RIGHTS_RESERVED)

  moderationState ModerationState @default(VISIBLE) @map("moderation_state")

  isMature Boolean @default(false) @map("is_mature")

  publishedAt DateTime? @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")
  deletedAt   DateTime? @map("deleted_at")

  orderingVersion Int    @default(1) @map("ordering_version")
  searchTitle     String @default("") @map("search_title") @db.Text
  searchText      String @default("") @map("search_text") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author     User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  genre      Genre?      @relation(fields: [genreId], references: [id], onDelete: SetNull)
  coverAsset MediaAsset? @relation("StoryCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  chapters Chapter[]
  tags     StoryTag[]

  libraryEntries   LibraryEntry[]
  readingProgress  ReadingProgress[]
  readingListItems ReadingListItem[]
  readingHistory   ReadingHistory[]
  readSignals      ReadSignal[]
  stats            StoryStats?
  dailyMetrics     DailyStoryMetric[]

  @@index([authorId, deletedAt, updatedAt])
  @@index([visibility, moderationState, publishedAt])
  @@index([genreId, visibility, publishedAt])
  @@index([status, scheduledAt])
  @@index([coverAssetId])
  @@index([searchTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "stories_search_title_trgm_idx")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "stories_search_text_trgm_idx")
  @@map("stories")
}

model StoryTag {
  storyId String @map("story_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId, createdAt])
  @@map("story_tags")
}

model Chapter {
  id      String @id @default(uuid()) @db.Uuid
  storyId String @map("story_id") @db.Uuid

  title    String @db.VarChar(200)
  position Int
  content  String @db.Text
  version  Int    @default(1)

  status          ChapterStatus   @default(DRAFT)
  moderationState ModerationState @default(VISIBLE) @map("moderation_state")

  wordCount Int @default(0) @map("word_count")

  publishedAt DateTime? @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")
  deletedAt   DateTime? @map("deleted_at")

  contentHash String @default("") @map("content_hash") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  votes           ChapterVote[]
  comments        Comment[]
  readingProgress ReadingProgress[]
  revisions       ChapterRevision[]
  readingHistory  ReadingHistory[]
  readSignals     ReadSignal[]

  @@unique([storyId, position])
  @@index([storyId, status, position])
  @@index([storyId, deletedAt])
  @@index([status, scheduledAt])
  @@map("chapters")
}

model ChapterRevision {
  id        String @id @default(uuid()) @db.Uuid
  chapterId String @map("chapter_id") @db.Uuid
  createdBy String @map("created_by") @db.Uuid

  revisionNumber Int            @map("revision_number")
  sourceVersion  Int            @map("source_version")
  title          String         @db.VarChar(200)
  content        String         @db.Text
  contentHash    String         @map("content_hash") @db.Char(64)
  wordCount      Int            @map("word_count")
  reason         RevisionReason
  protected      Boolean        @default(false)
  restoredFromId String?        @map("restored_from_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  chapter      Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  creator      User              @relation("RevisionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  restoredFrom ChapterRevision?  @relation("RevisionRestore", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restores     ChapterRevision[] @relation("RevisionRestore")

  @@unique([chapterId, revisionNumber])
  @@index([chapterId, createdAt])
  @@map("chapter_revisions")
}

model Follow {
  followerId  String @map("follower_id") @db.Uuid
  followingId String @map("following_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
  @@map("follows")
}

model Block {
  blockerId String @map("blocker_id") @db.Uuid
  blockedId String @map("blocked_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId, createdAt])
  @@map("blocks")
}

model Mute {
  muterId String @map("muter_id") @db.Uuid
  mutedId String @map("muted_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  muter User @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([mutedId, createdAt])
  @@map("mutes")
}

model LibraryEntry {
  userId  String @map("user_id") @db.Uuid
  storyId String @map("story_id") @db.Uuid

  addedAt DateTime @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([userId, storyId])
  @@index([userId, addedAt])
  @@index([storyId, addedAt])
  @@map("library_entries")
}

model ReadingProgress {
  userId    String  @map("user_id") @db.Uuid
  storyId   String  @map("story_id") @db.Uuid
  chapterId String? @map("chapter_id") @db.Uuid

  progress    Float     @default(0)
  anchor      String?   @db.VarChar(200)
  completedAt DateTime? @map("completed_at")

  lastReadAt DateTime @default(now()) @map("last_read_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@id([userId, storyId])
  @@index([userId, lastReadAt])
  @@index([chapterId])
  @@map("reading_progress")
}

model ReadingHistory {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  storyId   String  @map("story_id") @db.Uuid
  chapterId String? @map("chapter_id") @db.Uuid

  type       ReadingHistoryType
  progress   Float
  occurredAt DateTime           @default(now()) @map("occurred_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt, id])
  @@index([storyId, occurredAt])
  @@map("reading_history")
}

model ReadSignal {
  id        String  @id @default(uuid()) @db.Uuid
  storyId   String  @map("story_id") @db.Uuid
  chapterId String  @map("chapter_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid

  actorType   ReadActorType @map("actor_type")
  visitorKey  String        @map("visitor_key") @db.Char(64)
  bucketStart DateTime      @map("bucket_start")
  qualifiedAt DateTime      @default(now()) @map("qualified_at")

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([visitorKey, chapterId, bucketStart])
  @@index([storyId, qualifiedAt])
  @@index([userId, storyId])
  @@map("read_signals")
}

model ReadingList {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name            String  @db.VarChar(100)
  description     String? @db.VarChar(500)
  isPublic        Boolean @default(true) @map("is_public")
  orderingVersion Int     @default(1) @map("ordering_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ReadingListItem[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("reading_lists")
}

model ReadingListItem {
  readingListId String @map("reading_list_id") @db.Uuid
  storyId       String @map("story_id") @db.Uuid

  addedAt  DateTime @default(now()) @map("added_at")
  position Int

  readingList ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade)
  story       Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([readingListId, storyId])
  @@unique([readingListId, position])
  @@index([storyId, addedAt])
  @@map("reading_list_items")
}

model ChapterVote {
  userId    String @map("user_id") @db.Uuid
  chapterId String @map("chapter_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([chapterId, createdAt])
  @@map("chapter_votes")
}

model Comment {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  chapterId String  @map("chapter_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid

  content String @db.VarChar(2000)

  status CommentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")

  @@index([chapterId, createdAt])
  @@index([parentId, createdAt])
  @@index([userId, createdAt])
  @@map("comments")
}

model Notification {
  id          String  @id @default(uuid()) @db.Uuid
  recipientId String  @map("recipient_id") @db.Uuid
  actorId     String? @map("actor_id") @db.Uuid
  dedupeKey   String? @unique @map("dedupe_key") @db.VarChar(200)

  type NotificationType
  data Json

  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId, createdAt])
  @@map("notifications")
}

model Report {
  id String @id @default(uuid()) @db.Uuid

  reporterId   String  @map("reporter_id") @db.Uuid
  assignedToId String? @map("assigned_to_id") @db.Uuid

  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid

  reason  ReportReason
  details String?      @db.VarChar(2000)

  status     ReportStatus @default(OPEN)
  resolution String?      @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model ModerationAction {
  id String @id @default(uuid()) @db.Uuid

  moderatorId String @map("moderator_id") @db.Uuid

  targetType ReportTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid

  action ModerationActionType
  reason String?              @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at")

  moderator User @relation("ModerationActor", fields: [moderatorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId, createdAt])
  @@map("moderation_actions")
}

model MediaAsset {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  provider  MediaProvider
  objectKey String        @unique @map("object_key") @db.VarChar(500)
  publicUrl String        @map("public_url") @db.Text

  mimeType String @map("mime_type") @db.VarChar(100)
  byteSize Int    @map("byte_size")
  width    Int
  height   Int

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  owner          User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  coveredStories Story[] @relation("StoryCover")

  @@index([ownerId, createdAt])
  @@index([deletedAt])
  @@map("media_assets")
}

model StoryStats {
  storyId String @id @map("story_id") @db.Uuid

  voteCount            Int      @default(0) @map("vote_count")
  commentCount         Int      @default(0) @map("comment_count")
  libraryCount         Int      @default(0) @map("library_count")
  authenticatedReaders Int      @default(0) @map("authenticated_readers")
  qualifiedViews       Int      @default(0) @map("qualified_views")
  updatedAt            DateTime @updatedAt @map("updated_at")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@map("story_stats")
}

model UserStats {
  userId String @id @map("user_id") @db.Uuid

  followerCount       Int      @default(0) @map("follower_count")
  followingCount      Int      @default(0) @map("following_count")
  publishedStoryCount Int      @default(0) @map("published_story_count")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model DailyStoryMetric {
  storyId String   @map("story_id") @db.Uuid
  day     DateTime @db.Date

  qualifiedViews Int @default(0) @map("qualified_views")
  uniqueReaders  Int @default(0) @map("unique_readers")
  votes          Int @default(0)
  comments       Int @default(0)
  libraryAdds    Int @default(0) @map("library_adds")

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([storyId, day])
  @@index([day, qualifiedViews])
  @@map("daily_story_metrics")
}

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(120)
  aggregateType String       @map("aggregate_type") @db.VarChar(80)
  aggregateId   String       @map("aggregate_id") @db.VarChar(120)
  payload       Json
  status        OutboxStatus @default(PENDING)
  occurredAt    DateTime     @default(now()) @map("occurred_at")
  availableAt   DateTime     @default(now()) @map("available_at")
  leaseUntil    DateTime?    @map("lease_until")
  attempts      Int          @default(0)
  lastError     String?      @map("last_error") @db.VarChar(2000)
  dispatchedAt  DateTime?    @map("dispatched_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@map("outbox_messages")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(120)
  dedupeKey   String    @unique @map("dedupe_key") @db.VarChar(240)
  payload     Json
  status      JobStatus @default(PENDING)
  availableAt DateTime  @default(now()) @map("available_at")
  leaseUntil  DateTime? @map("lease_until")
  attempts    Int       @default(0)
  maxAttempts Int       @default(10) @map("max_attempts")
  lastError   String?   @map("last_error") @db.VarChar(2000)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([leaseUntil])
  @@map("jobs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(120)
  targetType String   @map("target_type") @db.VarChar(80)
  targetId   String?  @map("target_id") @db.VarChar(120)
  requestId  String?  @map("request_id") @db.VarChar(128)
  ipHash     String?  @map("ip_hash") @db.Char(64)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_logs")
}
